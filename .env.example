NEXT_PUBLIC_NEAR_NETWORK=testnet
# Per-account escrow contract. Default in the app is pocket.nearpocket.testnet.
# After deploying, set this on Vercel to the new account, for example pocket.nearpocket.testnet.
NEXT_PUBLIC_AGENT_POLICY_CONTRACT=pocket.nearpocket.testnet
NEAR_AI_API_KEY=
OPENAI_API_KEY=
NEAR_AI_BASE_URL=
NEAR_AI_MODEL=gpt-4o-mini
XENDIT_SECRET_KEY=
# Optional, off by default. 0xramp staging off-ramp adapter (src/lib/settlement/zeroxramp-adapter.ts).
# Leave empty: settlement then uses Xendit Test Mode (if XENDIT_SECRET_KEY is set) or the labeled mock.
ZEROXRAMP_PARTNER_ID=
ZEROXRAMP_API_BASE_URL=
ZEROXRAMP_API_KEY=
# Google / social login via Privy (https://privy.io) — enable Google + NEAR wallet in dashboard
NEXT_PUBLIC_PRIVY_APP_ID=
# scripts/testnet-demo.mjs only. Testnet account. Never commit a real key.
# Either set the two vars, or point NEAR_CREDENTIALS_FILE at {"account_id","private_key"}.
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
NEAR_CREDENTIALS_FILE=
# Defaults to pocket.nearpocket.testnet. Must be a .testnet account.
NEAR_CONTRACT_ID=
# Gasless relayer. Server only — never NEXT_PUBLIC_, never commit the key.
# The account nearpocket.testnet is configured on Vercel separately.
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=
# Optional for npm run relay:demo. JSON {"account_id","private_key"}.
RELAYER_CREDENTIALS_FILE=
# Testnet NEP-141 the relayer may forward. ft_transfer may attach 1 yoctoNEAR.
NEAR_USDC_CONTRACT_ID=usdc.fakes.testnet
# Live 1Click path. Leave unset. Broadcasting spends mainnet funds; the app refuses unless all three are "1".
NEAR_INTENTS_EXECUTE=
NEAR_INTENTS_BROADCAST=
NEAR_INTENTS_MAINNET_ACK=
