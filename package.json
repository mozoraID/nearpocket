{
  "name": "nearpocket",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:qris": "node scripts/test-qris.mjs",
    "test:i18n": "node scripts/test-i18n.mjs",
    "test:intents": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs scripts/test-intents.mts",
    "test:shop": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs scripts/test-shop.mts",
    "test:relay": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs scripts/test-relay.mts",
    "test:tx": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs scripts/test-tx-outcome.mts",
    "test:contract": "bash scripts/test-contract.sh",
    "testnet:demo": "node scripts/testnet-demo.mjs",
    "relay:demo": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs scripts/relay-demo.mjs",
    "test": "npm run test:qris && npm run test:i18n && npm run test:intents && npm run test:shop && npm run test:relay && npm run test:tx"
  },
  "dependencies": {
    "@near-wallet-selector/core": "^10.1.4",
    "@near-wallet-selector/hot-wallet": "^10.1.4",
    "@near-wallet-selector/intear-wallet": "^10.1.4",
    "@near-wallet-selector/meteor-wallet": "^10.1.4",
    "@near-wallet-selector/modal-ui": "^10.1.4",
    "@near-wallet-selector/near-mobile-wallet": "^10.1.4",
    "@noble/hashes": "^2.4.0",
    "@privy-io/react-auth": "^3.51.3",
    "@scure/bip39": "^2.4.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "bip39": "^3.1.2",
    "clsx": "^2.1.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.70.0",
    "near-api-js": "^7.4.0",
    "near-seed-phrase": "^0.2.1",
    "next": "15.5.29",
    "qrcode.react": "^4.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "NEAR-native wallet for local QR rails across Asia, worldwide USD card via NEAR Intents, marketplace shopping, and a shopping agent with on-chain approval."
}
